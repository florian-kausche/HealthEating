# Firebase Admin SDK configuration
# Option 1: Path to your Firebase service account key JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH="/path/to/your/serviceAccountKey.json"

# Option 2: Base64 encoded string of your service account key JSON file
# FIREBASE_SERVICE_ACCOUNT_KEY_BASE64="YOUR_BASE64_ENCODED_JSON_STRING"

# Choose one of the above and rename this file to .env
# Ensure this .env file is listed in .gitignore and not committed to the repository.

PORT=3001
FRONTEND_DEV_URL="http://localhost:3000" # For CORS configuration during development
# FRONTEND_PROD_URL="https://your-production-frontend-domain.com" # For CORS in production
NODE_ENV="development" # Affects error handling details, logging. Set to "production" in production.

# MongoDB Connection URI
# For local MongoDB instance:
MONGODB_URI="mongodb://localhost:27017/health_advisor_gh"
# For MongoDB Atlas or other cloud providers, use the connection string they provide:
# MONGODB_URI="mongodb+srv://<username>:<password>@yourcluster.mongodb.net/health_advisor_gh?retryWrites=true&w=majority"

# JWT Secret Key (if using custom JWTs alongside Firebase)
# JWT_SECRET="your_very_secret_key_here"

# Optional SMS Gateway Configuration (e.g., for Twilio, Africa's Talking, etc.)
# SMS_GATEWAY_PROVIDER="twilio" # Example: "twilio", "africastalking"
# SMS_GATEWAY_API_KEY="your_sms_api_key_or_sid"
# SMS_GATEWAY_AUTH_TOKEN="your_sms_auth_token_or_secret" # If applicable
# SMS_GATEWAY_SENDER_ID="YourAppNameOrPhoneNumber" # The "From" number or Alphanumeric Sender ID
# SMS_GATEWAY_API_URL="provider_specific_api_url" # If needed and not handled by SDK
